# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development
# Permissions are always enforced; the deprecated "legacy" value also enforces.
RBAC_ENFORCEMENT_MODE=enforce

# Required
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=365d

# Required for admin-only All Payments reporting. Use the external company
# ObjectId; never expose this as a NEXT_PUBLIC setting or browser parameter.
PAYMENTS_REPORT_COMPANY_ID=

# Not read by the backend (CORS reflects the request origin); kept for reference.
CLIENT_URL=

# Image uploads (handover, vehicle return, vehicles, maintenance)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp booking messages
WATI_API_URL=https://live-mt-server.wati.io
WATI_TENANT_ID=
WATI_API_TOKEN=

# Smart Leads intent heuristic (optional; defaults shown)
BOOKING_INTENT_WINDOW_DAYS=30
BOOKING_INTENT_HOT_THRESHOLD=75
BOOKING_INTENT_WARM_THRESHOLD=40
BOOKING_INTENT_VIEW_POINTS=5
BOOKING_INTENT_VIEW_CAP=20
BOOKING_INTENT_REPEAT_SESSION_POINTS=15
BOOKING_INTENT_DATES_POINTS=15
BOOKING_INTENT_FILTER_POINTS=5
BOOKING_INTENT_AVAILABILITY_POINTS=15
BOOKING_INTENT_CHECKOUT_POINTS=25
BOOKING_INTENT_ACTIVE_POINTS=5
