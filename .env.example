# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Required
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=365d

# Required for admin-only All Payments reporting. Use the external company
# ObjectId; never expose this as a NEXT_PUBLIC setting or browser parameter.
PAYMENTS_REPORT_COMPANY_ID=

# Not read by the backend (CORS reflects the request origin); kept for reference.
CLIENT_URL=

# Image uploads (handover, vehicle return, vehicles, maintenance)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp booking messages
WATI_API_URL=https://live-mt-server.wati.io
WATI_TENANT_ID=
WATI_API_TOKEN=
