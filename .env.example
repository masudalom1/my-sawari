# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Required
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=365d

# Not read by the backend (CORS reflects the request origin); kept for reference.
CLIENT_URL=

# Image uploads (handover, vehicle return, vehicles, maintenance)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp booking messages
WATI_API_URL=
WATI_TENANT_ID=
WATI_API_TOKEN=
